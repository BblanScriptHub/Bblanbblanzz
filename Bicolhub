    if not Character or not RootPart then return end

    SetNetworkOwnership()
    flyStartPosition = RootPart.Position
    CleanFly()

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.P = 5000
    flyBodyVelocity.Parent = RootPart

    safeCall(function()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Falling, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end)

    safeCall(function()
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)

    flyConnection = RunService.Heartbeat:Connect(function()
        if not flyToggleState then
            if flyEnabled then
                flyEnabled = false
                CleanFly()
                safeCall(function()
                    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Falling, true)
                    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
                end)
                safeCall(function()
                    for _, part in pairs(Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                end)
                if FlyToggle then
                    FlyToggle:Set(false)
                end
                print("[Fly] Flight stopped (slider disabled)")
            end
            return
        end

        if not RootPart or not flyBodyVelocity or not flyEnabled then
            return
        end

        SetNetworkOwnership()

        safeCall(function()
            local camLook = Camera.CFrame.LookVector
            local camRight = Camera.CFrame.RightVector
            local camUp = Camera.CFrame.UpVector

            local forward = Vector3.new(camLook.X, 0, camLook.Z).Unit
            local right = Vector3.new(camRight.X, 0, camRight.Z).Unit

            if forward.Magnitude < 0.1 then
                forward = Vector3.new(0, 0, -1)
                right = Vector3.new(1, 0, 0)
            end

            local move = Vector3.new(0, 0, 0)

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + forward end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - forward end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + camUp end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - camUp end

            if move.Magnitude > 0.01 then
                local vel = move.Unit * flySpeed
                flyBodyVelocity.Velocity = vel
                RootPart . CFrame = CFrame . new ( RootPart . Position + vel * 0.05 );
            else
                flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end

            if Humanoid.Health < 1 then
                Humanoid.Health = 999999999
            end
        end)
    end)
end

