local function DoSpin()
    if not spinEnabled or not RootPart then return end

    safeCall(function()
        SetNetworkOwnership()
        
        local currentCFrame = RootPart.CFrame
        local angle = spinSpeed * 2 * math.pi * 0.016
        local rotation = CFrame.Angles(0, angle, 0)
        local newCFrame = currentCFrame * rotation
        RootPart.CFrame = newCFrame
        RootPart.Position = newCFrame.Position
        
        local remote = ReplicatedStorage:FindFirstChild("RemoteEvent") 
            or ReplicatedStorage:FindFirstChild("MoveEvent") 
            or ReplicatedStorage:FindFirstChild("SyncEvent")
        
        if remote and remote:IsA("RemoteEvent") and remote.FireServer then
            safeCall(function()
                remote:FireServer("Move", newCFrame)
            end)
        end
    end)
end

local function StartSpin()
    if spinEnabled then return end
    spinEnabled = true
    SetNetworkOwnership()

    if spinConnection then
        spinConnection:Disconnect()
        spinConnection = nil
    end
    if spinSteppedConnection then
        spinSteppedConnection:Disconnect()
        spinSteppedConnection = nil
    end

    print("[Spin] Spinner started! Speed: " .. spinSpeed .. " rpm")

    spinConnection = RunService.Heartbeat:Connect(function()
        if not spinToggleState then
            if spinEnabled then
                spinEnabled = false
                StopSpin()
                if SpinToggle then
                    SpinToggle:Set(false)
                end
            end
            return
        end
        DoSpin()
    end)

    spinSteppedConnection = RunService.Stepped:Connect(function()
        if spinToggleState then
            DoSpin()
        end
    end)

    task.spawn(function()
        while spinEnabled and _G.ServerFly_Running do
            SetNetworkOwnership()
            task.wait(0.1)
        end
    end)

    task.spawn(function()
        while spinEnabled and _G.ServerFly_Running do
            safeCall(function()
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") and remote.FireServer then
                        local name = remote.Name:lower()
                        if name:find("move") or name:find("sync") or name:find("position") or name:find("update") then
                            safeCall(function()
                                remote:FireServer(RootPart.CFrame)
                            end)
                            break
                        end
                    end
                end
            end)
            task.wait(0.05)
        end
    end)
end

local function StopSpin()
